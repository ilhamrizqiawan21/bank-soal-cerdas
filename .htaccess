<IfModule mod_rewrite.c>
    RewriteEngine On

    # Defense in depth if a server accidentally points DocumentRoot to project root.
    RewriteRule ^(\.env|\.env\..*|artisan|composer\.(json|lock)|package(-lock)?\.json|bun\.lock|phpunit\.xml|vite\.config\.(js|ts)|tailwind\.config\.(js|ts))$ - [F,L,NC]
    RewriteRule ^(app|bootstrap|config|database|docs|node_modules|resources|routes|storage|tests|vendor)(/|$) - [F,L,NC]

    RewriteRule ^$ public/ [L]
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
